// Unattended-Upgrade::Origins-Pattern controls which packages are upgraded.
Unattended-Upgrade::Origins-Pattern {
{% for line in apt_uu_upgrade_origins_pattern %}
  "{%- for k,v in line.items() %}{{ k }}={{ v }}{% if not loop.last %},{% endif %}{%- endfor %}";
{% endfor %}
};

// Python regular expressions, matching packages to exclude from upgrading.
Unattended-Upgrade::Package-Blacklist {
{% for package in apt_uu_package_blacklist %}
  "{{ package }}";
{% endfor %}
};

// This option allows you to control if on a unclean dpkg exit.
Unattended-Upgrade::AutoFixInterruptedDpkg "{{ apt_uu_autofix_interrupted_dpkg | default(true) | bool | string | lower }}";

// Split the upgrade into the smallest possible chunks so that
// they can be interrupted with SIGUSR1. This makes the upgrade
// a bit slower but it has the benefit that shutdown while a upgrade
// is running is possible (with a small delay)
Unattended-Upgrade::MinimalSteps "{{ apt_uu_minimal_steps | default(true) | bool | string | lower }}";

// Install all updates when the machine is shutting down instead of doing it in
// the background while the machine is running.
Unattended-Upgrade::InstallOnShutdown "{{ apt_uu_install_on_shutdown | default(false) | bool | string | lower }}";

// Send email to this address for problems or packages upgrades
Unattended-Upgrade::Mail "{{ apt_uu_mail | default('') }}";

// Mail reporting threshold
Unattended-Upgrade::MailReport "{{ apt_uu_mail_report | default('only-on-error') }}";

// Remove unused automatically installed kernel-related packages
// (kernel images, kernel headers and kernel version locked tools).
Unattended-Upgrade::Remove-Unused-Kernel-Packages "{{ apt_uu_remove_unused_kernel_packages | default(true) | bool | string | lower }}";

// Do automatic removal of newly unused dependencies after the upgrade
Unattended-Upgrade::Remove-New-Unused-Dependencies "{{ apt_uu_remove_new_unused_dependencies | default(true) | bool | string | lower }}";

// Do automatic removal of unused packages after the upgrade
// (equivalent to apt-get autoremove)
Unattended-Upgrade::Remove-Unused-Dependencies "{{ unattended_remove_unused_dependencies | default(false) | bool | string | lower }}";

// Automatically reboot even if there are users currently logged in
// when Unattended-Upgrade::Automatic-Reboot is set to true
Unattended-Upgrade::Automatic-Reboot-WithUsers "{{ apt_uu_automatic_reboot_with_users | default(true) | bool | string | lower }}";

// Automatically reboot *WITHOUT CONFIRMATION* if
//  the file /var/run/reboot-required is found after the upgrade
Unattended-Upgrade::Automatic-Reboot "{{ apt_uu_automatic_reboot | default(true) | bool | string | lower }}";

// If automatic reboot is enabled and needed, reboot at the specific
// time instead of immediately
//  Default: "now"
Unattended-Upgrade::Automatic-Reboot-Time "{{ apt_uu_automatic_reboot_time | default('now') }}";

// Download and install upgrades only on AC power
// (i.e. skip or gracefully stop updates on battery)
Unattended-Upgrade::OnlyOnACPower "{{ apt_uu_only_on_ac_power | default(true) | bool | string | lower }}";

// Use apt bandwidth limit feature, this example limits the download
// speed to 70kb/sec
Acquire::http::Dl-Limit "{{ apt_uu_dl_limit | default(0) }}";

// Enable logging to syslog. Default is False
Unattended-Upgrade::SyslogEnable "{{ apt_uu_syslog_enable | default(false) | bool | string | lower }}";

// Specify syslog facility. Default is daemon
Unattended-Upgrade::SyslogFacility "{{ apt_uu_syslog_facility | default('daemon') }}";

// Download and install upgrades only on non-metered connection
// (i.e. skip or gracefully stop updates on a metered connection)
Unattended-Upgrade::Skip-Updates-On-Metered-Connections "{{ apt_uu_skip_updates_on_metered_connections | default(true) | bool | string | lower }}";

// Verbose logging
Unattended-Upgrade::Verbose "{{ apt_uu_verbose | default(false) | bool | string | lower }}";

// Print debugging information both in unattended-upgrades and
// in unattended-upgrade-shutdown
Unattended-Upgrade::Debug "{{ apt_uu_debug | default(false) | bool | string | lower }}";

// Allow package downgrade if Pin-Priority exceeds 1000
Unattended-Upgrade::Allow-downgrade "{{ apt_uu_allow_downgrade | default(false) | bool | string | lower }}";

// When APT fails to mark a package to be upgraded or installed try adjusting
// candidates of related packages to help APT's resolver in finding a solution
// where the package can be upgraded or installed.
// This is a workaround until APT's resolver is fixed to always find a
// solution if it exists. (See Debian bug #711128.)
// The fallback is enabled by default, except on Debian's sid release because
// uninstallable packages are frequent there.
// Disabling the fallback speeds up unattended-upgrades when there are
// uninstallable packages at the expense of rarely keeping back packages which
// could be upgraded or installed.
Unattended-Upgrade::Allow-APT-Mark-Fallback "{{ apt_uu_allow_apt_mark_fallback | default(true) | bool | string | lower }}";
